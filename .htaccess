# West Alexandria Dental Care - Apache/LiteSpeed rules (Hostinger shared hosting)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Force HTTPS and the canonical host (westalexandriadentalcare.com)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^westalexandriadentalcare\.com$ [NC]
RewriteRule ^ https://westalexandriadentalcare.com%{REQUEST_URI} [L,R=301]
# Clean URLs: /services -> /services/
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2|webmanifest)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
